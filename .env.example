# Google GenAI API Key (Required)
GOOGLE_API_KEY=your_gemini_api_key_here

# Core LLM Model Selection
MODEL_ID=gemini-2.5-flash
ANALYTICS_MODEL_ID=gemini-2.5-flash

# Context Cache Time-To-Live (e.g. 30s, 300s, 3600s)
CACHE_TTL=300s

# Instructor Admin Dashboard Password
ADMIN_PASSWORD=change_this_to_a_secure_password

